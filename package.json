{
  "name": "mockscope",
  "displayName": "MockScope",
  "description": "Ultra-fast, zero-trust API mocking and traffic interception directly from your editor.",
  "version": "0.2.0",
  "publisher": "mockscope",
  "author": "burdu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/burdu-13/MockScope.git"
  },
  "bugs": {
    "url": "https://github.com/burdu-13/MockScope/issues"
  },
  "homepage": "https://github.com/burdu-13/MockScope#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "mock",
    "mocking",
    "api-mock",
    "fake-api",
    "stubbing",
    "proxy",
    "reverse-proxy",
    "cdp",
    "devtools",
    "playwright",
    "msw",
    "openapi",
    "swagger",
    "graphql",
    "tanstack-query",
    "swr",
    "rtk-query",
    "wretch",
    "typescript",
    "react",
    "angular",
    "vite",
    "nextjs",
    "nuxt",
    "codelens",
    "traffic-inspector",
    "network",
    "offline"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/badge/Security-100%25%20Offline-success.svg",
      "href": "https://github.com/burdu-13/MockScope/blob/main/SECURITY.md",
      "description": "Zero Egress Local Sandbox"
    },
    {
      "url": "https://img.shields.io/badge/License-MIT-blue.svg",
      "href": "https://github.com/burdu-13/MockScope/blob/main/LICENSE",
      "description": "MIT License"
    }
  ],
  "icon": "media/mockscope-logo.png",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onView:mockscope.dashboardView",
    "onCommand:mockscope.openWorkbench",
    "onCommand:mockscope.openDashboard",
    "onCommand:mockscope.openPlayground",
    "onCommand:mockscope.showQuickActions",
    "onCommand:mockscope.startProxy",
    "onCommand:mockscope.attachCdp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mockscope.startProxy",
        "title": "MockScope: Start Local Mock Proxy",
        "category": "MockScope"
      },
      {
        "command": "mockscope.stopProxy",
        "title": "MockScope: Stop Local Mock Proxy",
        "category": "MockScope"
      },
      {
        "command": "mockscope.attachCdp",
        "title": "MockScope: Attach Browser CDP Bridge (Auto-Launch)",
        "category": "MockScope"
      },
      {
        "command": "mockscope.attachCdpCustom",
        "title": "MockScope: Attach CDP with Custom Port...",
        "category": "MockScope"
      },
      {
        "command": "mockscope.detachCdp",
        "title": "MockScope: Detach Browser CDP Bridge",
        "category": "MockScope"
      },
      {
        "command": "mockscope.connectProject",
        "title": "MockScope: 1-Click Connect Project Dev Server",
        "category": "MockScope",
        "icon": "$(zap)"
      },
      {
        "command": "mockscope.disconnectProject",
        "title": "MockScope: Disconnect Project Dev Server",
        "category": "MockScope"
      },
      {
        "command": "mockscope.mockCall",
        "title": "MockScope: Mock API Call",
        "category": "MockScope"
      },
      {
        "command": "mockscope.copyPlaywrightSpec",
        "title": "MockScope: Copy Playwright Route Spec",
        "category": "MockScope"
      },
      {
        "command": "mockscope.copyMswHandler",
        "title": "MockScope: Copy MSW v2 Handler",
        "category": "MockScope"
      },
      {
        "command": "mockscope.openWorkbench",
        "title": "MockScope: Open Workbench",
        "category": "MockScope",
        "icon": "media/mockscope-icon.svg"
      },
      {
        "command": "mockscope.openDashboard",
        "title": "MockScope: Open Traffic & Route Dashboard",
        "category": "MockScope",
        "icon": "media/mockscope-icon.svg"
      },
      {
        "command": "mockscope.openInBrowser",
        "title": "MockScope: Preview Mock Endpoint in Browser",
        "category": "MockScope",
        "icon": "$(globe)"
      },
      {
        "command": "mockscope.openPlayground",
        "title": "MockScope: Open Interactive Playground",
        "category": "MockScope",
        "icon": "$(beaker)"
      },
      {
        "command": "mockscope.showQuickActions",
        "title": "MockScope: Quick Control Hub",
        "category": "MockScope",
        "icon": "$(radio-tower)"
      },
      {
        "command": "mockscope.callActions",
        "title": "MockScope: Inspect or Mock API Call",
        "category": "MockScope"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mockscope.callActions",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mockscope.openWorkbench",
          "when": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mockscope.openWorkbench",
          "when": "view == mockscope.dashboardView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mockscope-explorer",
          "title": "MockScope",
          "icon": "media/mockscope-icon.svg"
        }
      ]
    },
    "views": {
      "mockscope-explorer": [
        {
          "type": "webview",
          "id": "mockscope.dashboardView",
          "name": "Live Traffic & Route Table"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mockscope.openWorkbench",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "MockScope",
      "properties": {
        "mockscope.proxyPort": {
          "type": "integer",
          "default": 45990,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port for the local loopback mock proxy (binds strictly to 127.0.0.1)."
        },
        "mockscope.cdpPort": {
          "type": "integer",
          "default": 9222,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port used for Chrome DevTools Protocol (CDP) wire interception (binds strictly to 127.0.0.1)."
        },
        "mockscope.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline MockScope action CodeLenses directly above detected API calls in code editors."
        },
        "mockscope.codeLensMode": {
          "type": "string",
          "enum": [
            "compact",
            "expanded"
          ],
          "default": "compact",
          "description": "Display a single state-aware CodeLens per API call (compact) or five separate action lenses (expanded)."
        },
        "mockscope.appUrl": {
          "type": "string",
          "default": "",
          "description": "Optional default local dev server URL (e.g. http://localhost:5173) used when auto-launching Chrome/Edge for CDP interception."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mockscope.gettingStarted",
        "title": "Get Started with MockScope",
        "description": "Synthesize typed mocks from source code, intercept loopback traffic, and export Playwright or MSW tests in 60 seconds.",
        "steps": [
          {
            "id": "openPlayground",
            "title": "Try the Interactive Playground",
            "description": "Open a sample TypeScript file containing fetch, axios, useQuery, and Angular HttpClient calls to see instant AST discovery, Hover previews, and state-aware CodeLens actions.\n[Open Playground](command:mockscope.openPlayground)",
            "media": {
              "image": "media/mockscope-workbench.png",
              "altText": "MockScope Workbench showing discovered endpoints"
            }
          },
          {
            "id": "openWorkbench",
            "title": "Inspect Scenarios in the Workbench",
            "description": "Press Ctrl+Alt+M (Cmd+Alt+M on macOS) or open the Workbench to switch between 200 Populated, Loading, Empty, 2FA, 401, and 500 error scenarios.\n[Open Workbench](command:mockscope.openWorkbench)",
            "media": {
              "image": "media/mockscope-scenarios.png",
              "altText": "MockScope Route Inspector with scenario presets"
            }
          },
          {
            "id": "connectAppOrCdp",
            "title": "Route Frontend Traffic (1-Click Proxy or CDP)",
            "description": "Connect Vite, Next.js, Angular, or Nuxt to 127.0.0.1:45990 in one click, or attach Chrome CDP with zero config changes.\n[1-Click Connect App](command:mockscope.connectProject)",
            "media": {
              "image": "media/mockscope-browser-interception.png",
              "altText": "Live browser interception powered by MockScope"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js --production",
    "watch": "node esbuild.config.js --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {
    "typescript": "^5.3.3",
    "ws": "^8.16.0"
  }
}
