{
  "name": "mockscope",
  "displayName": "MockScope",
  "description": "Ultra-fast, zero-trust API mocking and traffic interception directly from your editor.",
  "version": "0.1.1",
  "publisher": "mockscope",
  "author": "burdu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/burdu-13/MockScope.git"
  },
  "bugs": {
    "url": "https://github.com/burdu-13/MockScope/issues"
  },
  "homepage": "https://github.com/burdu-13/MockScope#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Programming Languages"
  ],
  "keywords": [
    "mock",
    "mocking",
    "api-mock",
    "fake-api",
    "stubbing",
    "proxy",
    "reverse-proxy",
    "cdp",
    "devtools",
    "playwright",
    "msw",
    "typescript",
    "react",
    "angular",
    "vite",
    "nextjs",
    "codelens",
    "traffic-inspector",
    "network",
    "offline"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/badge/Security-100%25%20Offline-success.svg",
      "href": "https://github.com/burdu-13/MockScope/blob/main/SECURITY.md",
      "description": "Zero Egress Local Sandbox"
    },
    {
      "url": "https://img.shields.io/badge/License-MIT-blue.svg",
      "href": "https://github.com/burdu-13/MockScope/blob/main/LICENSE",
      "description": "MIT License"
    }
  ],
  "icon": "media/mockscope-logo.png",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onView:mockscope.dashboardView",
    "onCommand:mockscope.openWorkbench",
    "onCommand:mockscope.openDashboard",
    "onCommand:mockscope.startProxy",
    "onCommand:mockscope.attachCdp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mockscope.startProxy",
        "title": "MockScope: Start Local Mock Proxy",
        "category": "MockScope"
      },
      {
        "command": "mockscope.stopProxy",
        "title": "MockScope: Stop Local Mock Proxy",
        "category": "MockScope"
      },
      {
        "command": "mockscope.attachCdp",
        "title": "MockScope: Attach Browser CDP Bridge (Auto-Launch)",
        "category": "MockScope"
      },
      {
        "command": "mockscope.attachCdpCustom",
        "title": "MockScope: Attach CDP with Custom Port...",
        "category": "MockScope"
      },
      {
        "command": "mockscope.detachCdp",
        "title": "MockScope: Detach Browser CDP Bridge",
        "category": "MockScope"
      },
      {
        "command": "mockscope.connectProject",
        "title": "MockScope: 1-Click Connect Project Dev Server",
        "category": "MockScope",
        "icon": "$(zap)"
      },
      {
        "command": "mockscope.disconnectProject",
        "title": "MockScope: Disconnect Project Dev Server",
        "category": "MockScope"
      },
      {
        "command": "mockscope.mockCall",
        "title": "MockScope: Mock API Call",
        "category": "MockScope"
      },
      {
        "command": "mockscope.copyPlaywrightSpec",
        "title": "MockScope: Copy Playwright Route Spec",
        "category": "MockScope"
      },
      {
        "command": "mockscope.copyMswHandler",
        "title": "MockScope: Copy MSW v2 Handler",
        "category": "MockScope"
      },
      {
        "command": "mockscope.openWorkbench",
        "title": "MockScope: Open Workbench",
        "category": "MockScope",
        "icon": "media/mockscope-icon.svg"
      },
      {
        "command": "mockscope.openDashboard",
        "title": "MockScope: Open Traffic & Route Dashboard",
        "category": "MockScope",
        "icon": "media/mockscope-icon.svg"
      },
      {
        "command": "mockscope.openInBrowser",
        "title": "MockScope: Preview Mock Endpoint in Browser",
        "category": "MockScope",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mockscope.openWorkbench",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "mockscope.openWorkbench",
          "when": "view == mockscope.dashboardView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mockscope-explorer",
          "title": "MockScope",
          "icon": "media/mockscope-icon.svg"
        }
      ]
    },
    "views": {
      "mockscope-explorer": [
        {
          "type": "webview",
          "id": "mockscope.dashboardView",
          "name": "Live Traffic & Route Table"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mockscope.openWorkbench",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "MockScope",
      "properties": {
        "mockscope.proxyPort": {
          "type": "integer",
          "default": 45990,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port for the local loopback mock proxy (binds strictly to 127.0.0.1)."
        },
        "mockscope.cdpPort": {
          "type": "integer",
          "default": 9222,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port used for Chrome DevTools Protocol (CDP) wire interception (binds strictly to 127.0.0.1)."
        },
        "mockscope.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline MockScope action CodeLenses directly above detected API calls in code editors."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js --production",
    "watch": "node esbuild.config.js --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {
    "typescript": "^5.3.3",
    "ws": "^8.16.0"
  }
}
